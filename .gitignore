# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Node
node_modules/

# Secrets
.env
.env.*
!.env.example

# Claude Code workspace (skills, sessions, scratch outputs)
/.claude/

# macOS finder metadata
.DS_Store

# Runtime session storage written by /api/sessions
/data/sessions/

# Bulk Anthem plan-doc PDFs harvested by scripts/download_anthem_docs.py.
# 60 MB+ of binary content; the discovery + download scripts can rebuild.
/data/raw/anthem_docs/

# Raw MRF CSVs and intermediate scope/ledger files. Rebuildable from
# scripts/download_ca_mrfs.py + retry_failed_ca_mrfs.py.
/data/mrfs/
/data/new/
/data/old/

# Non-loaded discovery rows (hospitals outside the CA-322 scope that
# the discovery pipeline saw but the ingest didn't keep). Filtered out
# of data/raw/*.csv so the published repo reflects the deployed scope.
/data/raw/others/

# Archived data — local-only, not tracked
_archive/

# Ingest / discovery scripts — kept local (under _archive/scripts/).
# These describe HOW the corpus is built; the corpus itself is what
# powers the deployed agent. Keep the "secret sauce" off the public repo.
/scripts/
